<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../sts2MultiplayerSpectatorModule/localization/**/*.json"
                      Link="localization/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../scripts/Localization/ModLocalization.cs" Link="ModLocalization.cs" />
    <Content Include="../../sts2MultiplayerSpectatorModule/localization/**/*.json"
             Link="localization/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../scripts/Network/SpectatorWireProtocol.cs" Link="SpectatorWireProtocol.cs" />
    <Compile Include="../../scripts/Network/BattleMessages.cs" Link="BattleMessages.cs" />
    <Compile Include="../../scripts/Activity/ActivityMessageStream.cs" Link="ActivityMessageStream.cs" />
  </ItemGroup>
</Project>
